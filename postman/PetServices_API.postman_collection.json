  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/petservices" }
  ],
  "item": [
    {
      "name": "01 - Autenticacion",
      "item": [
        {
          "name": "Login correcto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"alejandro@gmail.com\",\n  \"contrasena\": \"123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login incorrecto (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"alejandro@gmail.com\",\n  \"contrasena\": \"claveMala\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
