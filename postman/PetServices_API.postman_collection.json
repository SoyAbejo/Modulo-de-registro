{
  "info": {
    "name": "PetServices API - GA7-220501096-AA5-EV04",
    "description": "Coleccion de pruebas para los servicios REST del proyecto PetConnect (evidencia AA5-EV03). Incluye Auth, Clientes, Mascotas, Establecimientos, Servicios, Citas, Productos y Pedidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
