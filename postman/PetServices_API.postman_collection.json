            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fecha\": \"2026-09-01\",\n  \"hora\": \"10:00:00\",\n  \"idMascota\": 1,\n  \"idEstablecimiento\": 1,\n  \"estado\": \"en_proceso\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/citas", "host": ["{{baseUrl}}"], "path": ["api", "citas"] }
