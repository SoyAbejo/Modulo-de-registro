        },
        {
          "name": "Agendar cita",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fecha\": \"2026-09-01\",\n  \"hora\": \"10:00:00\",\n  \"idMascota\": 1,\n  \"idEstablecimiento\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/api/citas", "host": ["{{baseUrl}}"], "path": ["api", "citas"] }
          }
        },
        {
          "name": "Agendar cita con estado invalido (400)",
