<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml — Archivo de construcción Maven para PetServices
  ─────────────────────────────────────────────────────────
  Define las dependencias y el plugin para empacar el proyecto
  como archivo .war y desplegarlo en Apache Tomcat.

  Proyecto: PetServices - SENA GA7-220501096-AA2-EV02
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ── Identificación del proyecto ── -->
    <groupId>com.petservices</groupId>
    <artifactId>petservices</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>            <!-- Empaca como archivo .war para Tomcat -->

    <name>PetServices - SENA AA2-EV02</name>
    <description>Módulo de Gestión de Clientes - Registro y CRUD</description>

    <properties>
        <app.port>8081</app.port>
        <app.contextPath>/petservices</app.contextPath>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- ── Java Servlet API 4.0 (proporcionada por Tomcat, no se incluye en el .war) ── -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>   <!-- "provided" = Tomcat la provee en tiempo de ejecución -->
        </dependency>

        <!-- ── JSP API (también proporcionada por Tomcat) ── -->
        <dependency>
            <groupId>javax.servlet.jsp</groupId>
            <artifactId>javax.servlet.jsp-api</artifactId>
            <version>2.3.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- ── JSTL (para uso futuro de etiquetas JSP estándar) ── -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>jstl</artifactId>
            <version>1.2</version>
        </dependency>

        <!--
          ── MySQL Connector/J (DESCOMENTA cuando integres la base de datos real)
          <dependency>
              <groupId>mysql</groupId>
              <artifactId>mysql-connector-java</artifactId>
              <version>8.0.33</version>
          </dependency>
        -->

        <!-- ── Gson: serialización/deserialización JSON para los servicios REST (AA5-EV03) ── -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

    </dependencies>

    <build>
        <!-- El nombre del archivo .war que se despliega en Tomcat -->
        <finalName>petservices</finalName>

        <plugins>
            <!-- Plugin para construir el .war -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.3.2</version>
                <configuration>
                    <failOnMissingWebXml>true</failOnMissingWebXml>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.tomcat.maven</groupId>
                <artifactId>tomcat7-maven-plugin</artifactId>
                <version>2.2</version>
                <configuration>
                    <port>${app.port}</port>
                    <path>${app.contextPath}</path>
                    <uriEncoding>UTF-8</uriEncoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
