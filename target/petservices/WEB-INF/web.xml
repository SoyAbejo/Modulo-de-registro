<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.xml — Descriptor de despliegue de PetServices
  ─────────────────────────────────────────────────
  Configura la aplicación web para el servidor Tomcat.
  Define la página de bienvenida (index.jsp) y los parámetros globales.
  Los Servlets ya usan la anotación @WebServlet, por lo que no necesitan
  declararse aquí (Servlet 3.0+). Solo dejamos la config esencial.

  Proyecto: PetServices - SENA GA7-220501096-AA2-EV02
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>PetServices - GA7-220501096-AA2-EV02</display-name>
    <description>
        Sistema de gestión para tienda de servicios para mascotas.
        Módulo: Registro y Gestión de Clientes (CRUD).
    </description>

    <!-- ── Página de bienvenida: redirige al login automáticamente ── -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ── Configuración de sesión: 30 minutos de inactividad ── -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ── Páginas de error personalizadas (opcional, buena práctica) ── -->
    <error-page>
        <error-code>404</error-code>
        <location>/vistas/error404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/vistas/error500.jsp</location>
    </error-page>

</web-app>
